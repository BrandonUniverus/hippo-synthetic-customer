{
    admin off
    auto_https off
}
:8080 {
    root * /state/public
    encode gzip
    @partial path *.partial */*.partial
    respond @partial 404
    respond /health/live "ok" 200
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Content-Security-Policy "default-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'self'"
    }
    @downloads path /releases/*/files/*
    header @downloads Cache-Control "public, max-age=31536000, immutable"
    @catalog path /catalog.json /health/ready /releases/*/manifest.json
    header @catalog Cache-Control "no-store"
    file_server
}
