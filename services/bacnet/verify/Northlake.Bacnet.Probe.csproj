<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnergyHippoRoot Condition="'$(EnergyHippoRoot)' == ''">C:/Hippo/Git/univerus/energyhippo</EnergyHippoRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BACnet" Version="4.0.0" />
    <Compile Include="../server/Contracts.cs" Link="Contracts.cs" />
    <Compile Include="$(EnergyHippoRoot)/src/Tasks/EEMSuite.Tasks.Gateways/Bacnet/BacnetClient.cs" Link="ActualCollectorBacnetClient.cs" />
  </ItemGroup>
</Project>
