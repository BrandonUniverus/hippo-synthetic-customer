{
	admin off
	auto_https disable_redirects

	pki {
		ca local {
			intermediate_lifetime 180d
		}
	}
}

(northlake_branding) {
	handle_path /branding/* {
		root * /srv/northlake-branding
		# Shared brand assets are edited in place; make browsers revalidate them.
		header Cache-Control "no-cache"
		file_server
	}

	# The brand systems in brands/: tokens, fonts, logos and the preview gallery.
	handle_path /brands/* {
		root * /srv/brands
		header Cache-Control "no-cache"
		file_server
	}
}

https://{$IDENTITY_HOST:localhost}:8443 {
	tls {
		issuer internal {
			ca local
			lifetime 720h
		}
	}
	encode zstd gzip
	import northlake_branding

	header {
		Strict-Transport-Security "max-age=0"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	# The Northlake site. It is a Caddy template: its links into Energy Hippo read
	# EEMSUITE_APPLICATION_HOME_URL, NORTHLAKE_EEM_PROVIDER_KEY,
	# NORTHLAKE_PUBLIC_DASHBOARD_ID and NORTHLAKE_SOURCES_URL from the environment.
	@portal path / /index.html
	handle @portal {
		root * /srv/northlake-portal
		header Cache-Control "no-cache"
		templates
		file_server
	}

	# Northlake's own documents (guides, tariff sheets, onboarding package), read-only.
	handle_path /documents/* {
		root * /srv/northlake-documents
		file_server
	}

	# The source bundle's utility pages, as part of the site. The producer
	# rendered them with an older copy of the Northlake look, so the site serves
	# today's stylesheets, lockup and fonts in their place. The bundle's own
	# directory page is the site's Utilities section.
	redir /utilities /utilities/ 308
	handle_path /utilities/* {
		redir / "/#utilities" 302
		rewrite /branding/northlake-logo-reversed.svg /brands/northlake/logo.svg
		rewrite /branding/northlake-mark.svg /brands/northlake/mark.svg
		handle_path /branding/* {
			root * /srv/northlake-branding
			header Cache-Control "no-cache"
			file_server
		}
		handle_path /brands/* {
			root * /srv/brands
			header Cache-Control "no-cache"
			file_server
		}
		handle /assets/sources.css {
			root * /srv/northlake-sources-web
			rewrite * /sources.css
			header Cache-Control "no-cache"
			file_server
		}
		handle {
			reverse_proxy {$NORTHLAKE_SOURCES_UPSTREAM:host.docker.internal:18081}
		}
	}

	# The handheld meter-reading tool, as part of the site.
	redir /meter-reading /meter-reading/ 308
	handle_path /meter-reading/* {
		reverse_proxy {$NORTHLAKE_HANDHELD_UPSTREAM:host.docker.internal:18082}
	}

	@energyhippo path /open-energyhippo
	handle @energyhippo {
		redir {$EEMSUITE_APPLICATION_HOME_URL:https://localdev.energyhippo.com/Hippo/} 302
	}

	@configuration path /configure /configure/*
	handle @configuration {
		reverse_proxy configuration:8081
	}

	handle {
		reverse_proxy keycloak:8080
	}
}

https://{$NORTHLAKE_CUSTOMER_HOST:customer.localtest.me}:8443 {
	tls {
		issuer internal {
			ca local
			lifetime 720h
		}
	}
	encode zstd gzip
	import northlake_branding

	header {
		Strict-Transport-Security "max-age=0"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	handle {
		reverse_proxy customer-site:8082
	}
}
