# Generate a real identity/.env with:
#   pwsh ./identity/scripts/Initialize-Identity.ps1
#
# Placeholder secrets are intentionally rejected by the realm generator.
IDENTITY_HOST=localhost
IDENTITY_HTTPS_PORT=8443
IDENTITY_BIND_ADDRESS=127.0.0.1
IDENTITY_PUBLIC_BASE_URL=https://localhost:8443
NORTHLAKE_PROVIDER_DISPLAY_NAME=Northlake Synthetic Identity
NORTHLAKE_REALM_KEY=northlake
NORTHLAKE_ENABLE_OIDC=true
NORTHLAKE_ENABLE_SAML=true

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-generated-value
KEYCLOAK_DB_PASSWORD=replace-with-generated-value

EEMSUITE_OIDC_CLIENT_SECRET=replace-with-generated-value
EEMSUITE_OIDC_LEGACY_CLIENT_SECRET=replace-with-generated-value
NORTHLAKE_CUSTOMER_CLIENT_SECRET=replace-with-generated-value
SYNTHETIC_USER_PASSWORD=replace-with-generated-value

NORTHLAKE_CUSTOMER_PUBLIC_BASE_URL=https://customer.localtest.me:8443

EEMSUITE_APPLICATION_HOME_URL=https://localdev.energyhippo.com/Hippo/
EEMSUITE_OIDC_REDIRECT_URIS=https://localhost:7310/signin-oidc;https://localdev.energyhippo.com/Hippo/signin-oidc;https://localhost/Hippo/signin-oidc

EEMSUITE_SAML_PROFILES=Standard
EEMSUITE_SAML_STANDARD_ENTITY_ID=urn:energyhippo:eemsuite-web:saml:standard
EEMSUITE_SAML_STANDARD_ACS_URLS=https://localhost:7310/saml/northlake-saml-standard/acs;https://localdev.energyhippo.com/Hippo/saml/northlake-saml-standard/acs;https://localhost/Hippo/saml/northlake-saml-standard/acs
EEMSUITE_SAML_STANDARD_LOGOUT_URLS=https://localhost:7310/saml/northlake-saml-standard/logout;https://localdev.energyhippo.com/Hippo/saml/northlake-saml-standard/logout;https://localhost/Hippo/saml/northlake-saml-standard/logout

# Add Saml2Int to EEMSUITE_SAML_PROFILES only after EEMSuite has a current RSA
# signing/encryption credential. This path contains the public certificate only.
EEMSUITE_SAML2INT_ENTITY_ID=urn:energyhippo:eemsuite-web:saml:saml2int
EEMSUITE_SAML2INT_ACS_URLS=https://localdev.energyhippo.com/Hippo/saml/northlake-saml2int/acs;https://localhost/Hippo/saml/northlake-saml2int/acs
EEMSUITE_SAML2INT_LOGOUT_URLS=https://localdev.energyhippo.com/Hippo/saml/northlake-saml2int/logout;https://localhost/Hippo/saml/northlake-saml2int/logout
EEMSUITE_SAML2INT_SP_CERTIFICATE_FILE=

# Northlake is the SCIM client. Create the corresponding connection through
# EnergyHippo System Administration and paste its one-time bearer credential
# only into the ignored /configure/scim surface.
EEMSUITE_SCIM_BASE_URL=https://localdev.energyhippo.com/Public/scim/v2
EEMSUITE_SCIM_EXPECTED_COMPANY_IDS=1
EEMSUITE_SCIM_PROVISIONING_TEMPLATE=Northlake external-only users
EEMSUITE_SCIM_GROUP_BINDING_ATTRIBUTE=externalId
# Optional filename under identity/.runtime/certs; TLS verification is never disabled.
EEMSUITE_SCIM_TRUSTED_CA_CERTIFICATE=
